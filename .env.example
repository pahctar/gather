# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks).
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (or the newer "publishable" key, sb_publishable_...).
# This key is safe in the browser: row-level security protects the data.
# Do NOT put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
